{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "tasks": {
    "start": "bash ./scripts/run.sh",
    "daemon": "bash ./scripts/daemon.sh",
    "stop": "bash ./scripts/stop.sh",
    "restart": "bash ./scripts/restart.sh",
    "status": "bash ./scripts/status.sh",
    "logs": "tail -f logs/main.log logs/telnet.log",
    "update": "deno run -A --minimum-dependency-age=0 jsr:@ursamu/cli@0.1.6/update",
    "safe-update": "bash ./scripts/safe-update.sh",
    "safe-update:reboot": "bash ./scripts/safe-update.sh --reboot",
    "server": "deno run -A --minimum-dependency-age=0 --unstable-detect-cjs --unstable-kv --unstable-net --watch ./src/main.ts",
    "telnet": "deno run -A --minimum-dependency-age=0 --unstable-detect-cjs --unstable-kv --unstable-net ./src/telnet.ts",
    "test": "deno test --allow-all --unstable-kv --no-check --minimum-dependency-age=0",
    "showcase": "deno run -A --minimum-dependency-age=0 ./src/cli/showcase.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "ursamu": "jsr:@ursamu/mush@1.0.40",
    "@ursamu/mush": "jsr:@ursamu/mush@1.0.40",
    "@ursamu/mush/app": "jsr:@ursamu/mush@1.0.40/app",
    "@ursamu/core": "jsr:@ursamu/core@1.0.6",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv/load": "jsr:@std/dotenv@^0.224.0/load",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.2",
    "@nicia-ai/typegraph": "npm:@nicia-ai/typegraph@^0.31.0",
    "@nicia-ai/typegraph/postgres/pglite": "npm:@nicia-ai/typegraph@^0.31.0/postgres/pglite",
    "zod": "npm:zod@4.4.3",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "@ursamu/parser": "npm:@ursamu/parser@1.2.4",
    "@digibear/tags": "npm:@digibear/tags@1.0.0",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "quickjs-emscripten": "npm:quickjs-emscripten@0.29.0",
    "sucrase": "npm:sucrase@^3.35.0",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse",
    "jsr:@ursamu/mush@^1.0.0": "jsr:@ursamu/mush@1.0.40",
    "jsr:@ursamu/mush@^1.0.30": "jsr:@ursamu/mush@1.0.40",
    "jsr:@ursamu/mush@^0.1.1": "jsr:@ursamu/mush@1.0.40",
    "jsr:@ursamu/mush@^0.2.0": "jsr:@ursamu/mush@1.0.40",
    "jsr:@ursamu/core@^1.0.0": "jsr:@ursamu/core@1.0.6",
    "jsr:@ursamu/core@^1.0.2": "jsr:@ursamu/core@1.0.6",
    "@ursamu/globals": "jsr:@ursamu/globals",
    "@ursamu/help": "jsr:@ursamu/help@^1.3.1",
    "@ursamu/help/register": "jsr:@ursamu/help@^1.3.1/register",
    "@ursamu/jobs": "jsr:@ursamu/jobs@^1.2.0",
    "@ursamu/bbs": "jsr:@ursamu/bbs@^1.2.0",
    "@ursamu/mail": "jsr:@ursamu/mail@^2.9.0",
    "@ursamu/wiki": "jsr:@ursamu/wiki@^0.2.9",
    "@ursamu/channels": "jsr:@ursamu/channels@^1.2.0",
    "@ursamu/builder": "jsr:@ursamu/builder@^1.3.0",
    "@ursamu/web": "jsr:@ursamu/web@^0.2.82",
    "@ursamu/site": "jsr:@ursamu/site@^0.1.96"
  }
}